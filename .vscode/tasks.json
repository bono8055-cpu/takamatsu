{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Resume Claude Code session",
      "type": "shell",
      "command": "claude --continue; if ($LASTEXITCODE -ne 0) { claude }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoLogo", "-NoProfile", "-Command"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
